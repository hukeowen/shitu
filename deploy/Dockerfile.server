# 后端镜像。构建：在 server/ 下先 mvn -B package -DskipTests，再
#   docker build -f deploy/Dockerfile.server -t shitu-server:<版本> server/shitu-app/target
FROM eclipse-temurin:17-jre
ENV TZ=Asia/Shanghai \
    SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai -XX:+ExitOnOutOfMemoryError"
RUN groupadd -r shitu && useradd -r -g shitu shitu && mkdir -p /var/log/shitu /data/uploads && chown -R shitu:shitu /var/log/shitu /data
USER shitu
WORKDIR /app
COPY shitu-app-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
