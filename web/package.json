{
  "name": "shitu-web",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:seeker": "pnpm --filter @shitu/seeker dev",
    "dev:staff": "pnpm --filter @shitu/staff dev",
    "dev:console": "pnpm --filter @shitu/console dev",
    "dev:ops": "pnpm --filter @shitu/ops dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vue-tsc": "2.1.10"
  }
}
